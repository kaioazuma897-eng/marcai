# Porta HTTP e endereço público (usado nos links enviados ao cliente)
PORT=3000
BASE_URL=http://localhost:3000

# Senha inicial do painel (pode ser trocada depois em Configurações)
ADMIN_PASSWORD=admin123

# Modelo usado quando o banco está vazio: barbearia | salao | clinica | oficina
SEGMENT=barbearia
# Popular com agendamentos fictícios para demonstração (1 = sim)
DEMO_DATA=1

# Envio de mensagens: log | webhook | twilio
NOTIFY_PROVIDER=log

# webhook: POST JSON {to, email, message, kind, appointment} — funciona com n8n, Make, Evolution API, Z-API etc.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# twilio: WhatsApp (From = whatsapp:+14155238886) ou SMS (From = +1555...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
